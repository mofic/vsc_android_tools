{
  "name": "android-device-tools",
  "displayName": "Android Device Tools",
  "description": "Android 设备、文件、应用与彩色 Logcat 管理",
  "version": "0.2.12",
  "publisher": "local-android-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "构建和设备写入操作要求信任工作区"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/remote-path.js && node --check src/root-files.js && node --check src/run-targets.js && node --check src/core.js && node --check src/extension.js && node --check src/logcat.js && node --check media/logcat.js && node --check src/device-capture.js && node --check src/capture.js && node --check src/log-query.js && node --check src/app-view.js && node --check media/app.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "androidTools.refresh",
        "title": "刷新设备和文件",
        "category": "Android Tools",
        "icon": "$(refresh)"
      },
      {
        "command": "androidTools.selectDevice",
        "title": "选择设备",
        "category": "Android Tools",
        "icon": "$(device-mobile)"
      },
      {
        "command": "androidTools.selectProject",
        "title": "选择 Android 项目",
        "category": "Android Tools",
        "icon": "$(folder-opened)"
      },
      {
        "command": "androidTools.browse",
        "title": "跳转设备目录",
        "category": "Android Tools",
        "icon": "$(go-to-file)"
      },
      {
        "command": "androidTools.open",
        "title": "打开设备文件",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.save",
        "title": "保存编辑到设备",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.newFile",
        "title": "新建文件",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.newFolder",
        "title": "新建文件夹",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.rename",
        "title": "重命名",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.delete",
        "title": "删除设备文件",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.upload",
        "title": "上传文件",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.uploadFolder",
        "title": "上传文件夹",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.download",
        "title": "下载",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.build",
        "title": "运行（编译、安装并启动）",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.clearDataAndRun",
        "title": "清除数据并运行",
        "category": "Android Tools",
        "icon": "$(debug-restart)"
      },
      {
        "command": "androidTools.install",
        "title": "安装已有 APK",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.launch",
        "title": "启动应用",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.stop",
        "title": "停止应用",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.uninstall",
        "title": "卸载应用",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.clearData",
        "title": "清空应用数据",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.revoke",
        "title": "撤销运行时权限",
        "category": "Android Tools"
      },
      {
        "command": "androidTools.logcat",
        "title": "打开 Logcat",
        "category": "Android Tools",
        "icon": "$(output)"
      },
      {
        "command": "androidTools.openAppDirectory",
        "title": "打开当前应用目录",
        "category": "Android Tools",
        "icon": "$(folder-library)"
      },
      {
        "command": "androidTools.goParent",
        "title": "返回设备上一级目录",
        "category": "Android Tools",
        "icon": "$(arrow-up)"
      },
      {
        "command": "androidTools.importLogcat",
        "title": "导入 Logcat 日志",
        "category": "Android Tools",
        "icon": "$(folder-opened)"
      },
      {
        "command": "androidTools.goBack",
        "title": "后退设备目录",
        "category": "Android Tools",
        "icon": "$(arrow-left)"
      },
      {
        "command": "androidTools.goForward",
        "title": "前进设备目录",
        "category": "Android Tools",
        "icon": "$(arrow-right)"
      },
      {
        "command": "androidTools.recentDirectories",
        "title": "最近设备目录",
        "category": "Android Tools",
        "icon": "$(history)"
      },
      {
        "command": "androidTools.enterDirectory",
        "title": "在此目录浏览",
        "category": "Android Tools",
        "icon": "$(folder-opened)"
      },
      {
        "command": "androidTools.copyPath",
        "title": "复制设备路径",
        "category": "Android Tools",
        "icon": "$(copy)"
      },
      {
        "command": "androidTools.refreshDirectory",
        "title": "刷新所选目录",
        "category": "Android Tools",
        "icon": "$(refresh)"
      },
      {
        "command": "androidTools.selectPackage",
        "title": "确认／切换项目包名",
        "category": "Android Tools",
        "icon": "$(symbol-package)"
      },
      {
        "command": "androidTools.installProject",
        "title": "安装当前项目 APK",
        "category": "Android Tools",
        "icon": "$(package)"
      },
      {
        "command": "androidTools.appSettings",
        "title": "打开应用设置",
        "category": "Android Tools",
        "icon": "$(settings-gear)"
      },
      {
        "command": "androidTools.dateSettings",
        "title": "打开时间设置",
        "category": "Android Tools",
        "icon": "$(settings-gear)"
      },
      {
        "command": "androidTools.languageSettings",
        "title": "打开语言设置",
        "category": "Android Tools",
        "icon": "$(settings-gear)"
      },
      {
        "command": "androidTools.developerSettings",
        "title": "打开开发者选项",
        "category": "Android Tools",
        "icon": "$(settings-gear)"
      },
      {
        "command": "androidTools.screenshot",
        "title": "设备截屏",
        "category": "Android Tools",
        "icon": "$(device-camera)"
      },
      {
        "command": "androidTools.record",
        "title": "开始录屏（无声，最长180秒）",
        "category": "Android Tools",
        "icon": "$(record)"
      },
      {
        "command": "androidTools.stopRecording",
        "title": "停止录屏并保存",
        "category": "Android Tools",
        "icon": "$(debug-stop)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "androidTools",
          "title": "Android Tools",
          "icon": "media/android.svg"
        }
      ]
    },
    "views": {
      "androidTools": [
        {
          "id": "androidDevices",
          "name": "设备"
        },
        {
          "id": "androidApp",
          "name": "项目应用",
          "type": "webview"
        },
        {
          "id": "androidFiles",
          "name": "设备文件"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "androidTools.refresh",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.selectDevice",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.selectProject",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.browse",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.logcat",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.openAppDirectory",
          "when": "view == androidDevices",
          "group": "navigation"
        },
        {
          "command": "androidTools.importLogcat",
          "when": "view == androidDevices",
          "group": "2_logcat"
        },
        {
          "command": "androidTools.goBack",
          "when": "view == androidFiles",
          "group": "navigation@0"
        },
        {
          "command": "androidTools.goForward",
          "when": "view == androidFiles",
          "group": "navigation@1"
        },
        {
          "command": "androidTools.goParent",
          "when": "view == androidFiles",
          "group": "navigation@2"
        },
        {
          "command": "androidTools.refresh",
          "when": "view == androidFiles",
          "group": "navigation@3"
        },
        {
          "command": "androidTools.browse",
          "when": "view == androidFiles",
          "group": "navigation@4"
        },
        {
          "command": "androidTools.recentDirectories",
          "when": "view == androidFiles",
          "group": "2_files"
        },
        {
          "command": "androidTools.openAppDirectory",
          "when": "view == androidFiles",
          "group": "2_files"
        },
        {
          "command": "androidTools.newFile",
          "when": "view == androidFiles",
          "group": "2_files"
        },
        {
          "command": "androidTools.newFolder",
          "when": "view == androidFiles",
          "group": "2_files"
        },
        {
          "command": "androidTools.upload",
          "when": "view == androidFiles",
          "group": "2_files"
        },
        {
          "command": "androidTools.uploadFolder",
          "when": "view == androidFiles",
          "group": "2_files"
        }
      ],
      "view/item/context": [
        {
          "command": "androidTools.open",
          "when": "view == androidFiles && (viewItem == androidFile || viewItem == androidLinkFile)"
        },
        {
          "command": "androidTools.newFile",
          "when": "view == androidFiles && (viewItem == androidDirectory || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.newFolder",
          "when": "view == androidFiles && (viewItem == androidDirectory || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.rename",
          "when": "view == androidFiles && (viewItem == androidFile || viewItem == androidDirectory || viewItem == androidLinkFile || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.delete",
          "when": "view == androidFiles && (viewItem == androidFile || viewItem == androidDirectory || viewItem == androidLinkFile || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.upload",
          "when": "view == androidFiles && (viewItem == androidDirectory || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.uploadFolder",
          "when": "view == androidFiles && (viewItem == androidDirectory || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.download",
          "when": "view == androidFiles && (viewItem == androidFile || viewItem == androidDirectory || viewItem == androidLinkFile || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.enterDirectory",
          "when": "view == androidFiles && (viewItem == androidDirectory || viewItem == androidLinkDirectory)"
        },
        {
          "command": "androidTools.copyPath",
          "when": "view == androidFiles && viewItem != androidParent"
        },
        {
          "command": "androidTools.refreshDirectory",
          "when": "view == androidFiles && viewItem != androidParent"
        },
        {
          "command": "androidTools.screenshot",
          "when": "view == androidDevices && (viewItem == androidDevice || viewItem == androidDeviceRecording || viewItem == androidDeviceBusy)",
          "group": "inline@1"
        },
        {
          "command": "androidTools.record",
          "when": "view == androidDevices && viewItem == androidDevice",
          "group": "inline@2"
        },
        {
          "command": "androidTools.stopRecording",
          "when": "view == androidDevices && viewItem == androidDeviceRecording",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Android Tools",
      "properties": {
        "androidTools.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "ADB 可执行文件路径"
        },
        "androidTools.scanDepth": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 12,
          "description": "工作区项目发现深度"
        }
      }
    }
  }
}
